# Development Dockerfile for Flash Framework
FROM node:23-bullseye

# Install system dependencies for C++ development
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    ninja-build \
    clang \
    clang-format \
    libc++-dev \
    libc++abi-dev \
    python3 \
    python3-pip \
    git \
    curl \
    vim \
    htop \
    && rm -rf /var/lib/apt/lists/*

# Install development tools
RUN npm install -g typescript ts-node nodemon @types/node

# Set working directory
WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./
COPY tsconfig.json ./
COPY binding.gyp ./

# Copy C++ source files (needed for node-gyp during npm install)
COPY cpp/ ./cpp/

# Install Node.js dependencies (this will build the native addon)
RUN npm ci

# Copy rest of source code
COPY src/ ./src/
COPY examples/ ./examples/
COPY tests/ ./tests/
COPY benchmarks/ ./benchmarks/

# Build TypeScript
RUN npm run build:ts

# Expose ports
EXPOSE 3000 9229

# Default command for development
CMD ["npm", "run", "dev"]