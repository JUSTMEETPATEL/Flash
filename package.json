{
  "name": "flash-framework",
  "version": "0.1.0-alpha",
  "description": "High-performance C++/TypeScript HTTP server framework",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run build:cpp && npm run build:ts",
    "build:cpp": "node-gyp rebuild",
    "build:ts": "tsc",
    "build:debug": "npm run build:cpp:debug && npm run build:ts",
    "build:cpp:debug": "node-gyp rebuild --debug",
    "test": "npm run test:ts",
    "test:ts": "jest",
    "test:cpp": "cd build && ctest",
    "test:all": "npm run test:cpp && npm run test:ts",
    "clean": "rm -rf build dist node_modules/.cache",
    "dev": "ts-node examples/hello-world/server.ts",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:fix": "eslint src/**/*.ts tests/**/*.ts --fix",
    "docker:build": "docker build -t flash-framework .",
    "docker:run": "docker run -p 5627:5627 flash-framework",
    "docker:dev": "docker-compose up dev",
    "benchmark": "node benchmarks/scripts/benchmark.js"
  },
  "keywords": [
    "http-server",
    "cpp",
    "typescript",
    "high-performance",
    "n-api"
  ],
  "author": "Meet Patel",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "node-addon-api": "^7.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/__tests__/**/*.ts",
      "**/?(*.)+(spec|test).ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
